---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import DBTLCycleDisplay from '../components/DBTLCycleDisplay.astro';
import MolecularDnaViewer from '../components/MolecularDnaViewer.astro';
import ResearchAscent from '../components/ResearchAscent.astro';
import { siteConfig } from '../data/siteConfig';
import { getResearchHierarchy, sortResearchByHierarchy } from '../data/researchHierarchy';
import { getCollection } from 'astro:content';
import { includeEntryInEnvironment } from '../lib/contentFilters';

const researchAreas = sortResearchByHierarchy(
  (await getCollection('research')).filter(includeEntryInEnvironment),
).map((entry) => ({
  order: getResearchHierarchy(entry.id).order,
  title: entry.data.title,
  summary: entry.data.summary,
  href: `/research/${entry.id}/`,
}));

const applications = [
  {
    id: 'resilient-crops',
    title: 'Resilient crops',
    desc: 'Biodesign workflows for more nutritious, robust, and sustainable plant systems.',
    image: '/images/capabilities/resilient-crops.jpg',
    imageAlt: 'Deep red amaranth growing in a field',
    imageFit: 'cover',
  },
  {
    id: 'microbiome-therapeutics',
    title: 'Microbiome therapeutics',
    desc: 'Programmable living systems that can sense, respond, and support healthier communities.',
    image: '/images/capabilities/microbiome-therapeutics.jpg',
    imageAlt: 'Glass bottles containing a home-cultured microbial drink',
    imageFit: 'cover',
  },
  {
    id: 'reusable-infrastructure',
    title: 'Reusable infrastructure',
    desc: 'Open tools and standards that make biological engineering easier to reproduce and extend.',
    image: '/images/capabilities/reusable-infrastructure-sbol.svg',
    imageAlt: 'SBOL, Synthetic Biology Open Language',
    imageFit: 'contain',
  },
];

const publications = [
  {
    title: 'PhD thesis',
    desc: 'Automated design, build, test, learn workflows to engineer synthetic genetic networks.',
  },
  { title: 'LOICA', desc: 'Design automation for genetic networks.' },
  {
    title: 'SBOL and metadata',
    desc: 'Standards-enabled infrastructure for reproducible biological engineering.',
  },
];

const labNotes = [
  {
    title: 'Launching the DRAGGON Lab website',
    desc: 'An invitation to build open AI-aided biodesign platforms.',
  },
  {
    title: 'What is biological software engineering?',
    desc: 'A research explainer for the lab identity.',
  },
  {
    title: 'From DBTL to AI-aided biodesign',
    desc: 'A software-platform note for the DRAGGON ecosystem.',
  },
];
---

<BaseLayout
  title="DRAGGON Lab"
  description="AI-aided biodesign platforms for programming biological systems."
>
  <div class="hero-band">
    <section class="relative z-10 mx-auto max-w-7xl px-4 pt-20 pb-16">
      <p
        class="text-draggon-muted inline-flex items-center gap-2 text-[0.72rem] font-semibold tracking-[0.16em] uppercase"
        data-reveal
        style="--reveal-delay: 0ms"
      >
        <span class="bg-draggon-green inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"
        ></span>
        {siteConfig.affiliation}
      </p>
      <h1
        class="hero-title mt-5 max-w-4xl text-5xl text-slate-950 sm:text-6xl"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        AI-aided biodesign platforms for<br />
        <span class="hero-accent hero-accent--animate" data-hero-accent>programming</span> biological
        systems
      </h1>
      <p
        class="mt-7 max-w-2xl text-lg leading-8 text-slate-600"
        data-reveal
        style="--reveal-delay: 180ms"
      >
        We develop software, data, and automation workflows to engineer organisms with novel
        capabilities, from more nutritious and resilient crops to microbiome therapeutics.
      </p>
      <p class="mt-4 max-w-2xl text-sm text-slate-500" data-reveal style="--reveal-delay: 240ms">
        Developing, Researching, and Architecting Genetic and GenOmic Networks
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 300ms">
        <ButtonLink href="/research">Explore Research</ButtonLink>
        <ButtonLink href="/tools" variant="secondary">Explore Tools</ButtonLink>
      </div>
    </section>
    <MolecularDnaViewer />
  </div>

  {/* Research — the visual ascent makes the platform dependency explicit. */}
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-24">
    <div class="grid gap-10 md:grid-cols-[20rem_1fr] md:gap-16">
      <div class="md:sticky md:top-24 md:self-start">
        <h2 class="text-3xl tracking-tight text-slate-950">
          Programming biology with modern platforms
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          DRAGGON Lab builds AI-aided biodesign platforms that connect biological software
          foundations, automated DBTL workflows, machine learning, digital twins, and genetic
          network engineering.
        </p>
        <a
          href="/research"
          class="link-arrow text-draggon-violet mt-6 inline-flex items-center gap-2 text-sm font-semibold"
        >
          Explore all research <span class="agenda-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <ResearchAscent items={researchAreas} />
    </div>
  </section>

  {/* Platform — the rich DBTL widget carries this section */}
  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="dbtl-platform-layout">
      <div class="dbtl-platform-intro">
        <p class="dbtl-platform-eyebrow">
          <span>Infrastructure is at the core</span>
          <span class="dbtl-platform-eyebrow__line" aria-hidden="true"></span>
        </p>
        <h2 class="text-3xl tracking-tight text-slate-950">
          A software ecosystem for the DBTL cycle
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          We build open source software, standards-enabled metadata, and FAIR data workflows so that
          biological engineering can become more reproducible, collaborative, and programmable.
        </p>
        <div class="mt-6">
          <ButtonLink href="/tools" variant="secondary">View software ecosystem</ButtonLink>
        </div>
      </div>
      <div class="dbtl-platform-display">
        <DBTLCycleDisplay />
      </div>
    </div>
  </section>

  {/* Applications — synchronized descriptions and a selectable image stack. */}
  <div class="section-tint">
    <section class="capabilities mx-auto max-w-7xl px-4 py-16 md:py-20" data-capabilities>
      <h2 class="max-w-2xl text-3xl tracking-tight text-slate-950">
        Engineering organisms with useful capabilities
      </h2>
      <div class="capabilities__layout mt-10">
        <div class="capability-options" aria-label="Applications">
          {
            applications.map((app, index) => (
              <button
                class="capability-option"
                type="button"
                data-capability-select={app.id}
                aria-controls={`capability-image-${app.id}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class="capability-option__marker" aria-hidden="true" />
                <span>
                  <span class="capability-option__title" id={`capability-description-${app.id}`}>
                    {app.title}
                  </span>
                  <span class="capability-option__description">{app.desc}</span>
                </span>
              </button>
            ))
          }
        </div>

        <div class="capability-stack" aria-label="Application images">
          <div class="capability-stack__stage">
            {
              applications.map((app, index) => (
                <button
                  class:list={[
                    'capability-image-card',
                    { 'capability-image-card--contained': app.imageFit === 'contain' },
                  ]}
                  id={`capability-image-${app.id}`}
                  type="button"
                  data-capability-select={app.id}
                  data-capability-card
                  data-position={index === 0 ? 'active' : `back-${index}`}
                  aria-label={`Show ${app.title}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <img
                    src={app.image}
                    alt={app.imageAlt}
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    style={`object-fit: ${app.imageFit}`}
                  />
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* Recent outputs — two-column typographic index (publications + notes) */}
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-24">
    <h2 class="text-3xl tracking-tight text-slate-950">Recent outputs</h2>
    <div class="mt-10 grid gap-x-16 gap-y-12 md:grid-cols-2">
      <div>
        <div class="flex items-baseline justify-between border-b border-slate-200 pb-3">
          <h3 class="text-xs font-semibold tracking-[0.16em] text-slate-500 uppercase">
            Publications
          </h3>
          <a
            href="/publications"
            class="link-arrow text-draggon-violet inline-flex items-center gap-1.5 text-xs font-semibold"
          >
            Browse all <span class="agenda-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <ul>
          {
            publications.map((p) => (
              <li>
                <a
                  href="/publications"
                  class="entry group flex gap-4 border-b border-slate-200 py-4"
                >
                  <span
                    class="bg-draggon-violet mt-2 h-1.5 w-1.5 shrink-0 rounded-full"
                    aria-hidden="true"
                  />
                  <span>
                    <span class="entry-title block font-semibold text-slate-950">{p.title}</span>
                    <span class="mt-1 block text-sm leading-6 text-slate-600">{p.desc}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <div class="flex items-baseline justify-between border-b border-slate-200 pb-3">
          <h3 class="text-xs font-semibold tracking-[0.16em] text-slate-500 uppercase">
            Lab Notes
          </h3>
          <a
            href="/lab-notes"
            class="link-arrow text-draggon-violet inline-flex items-center gap-1.5 text-xs font-semibold"
          >
            Read all <span class="agenda-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <ul>
          {
            labNotes.map((note) => (
              <li>
                <a href="/lab-notes" class="entry group flex gap-4 border-b border-slate-200 py-4">
                  <span
                    class="bg-draggon-green mt-2 h-1.5 w-1.5 shrink-0 rounded-full"
                    aria-hidden="true"
                  />
                  <span>
                    <span class="entry-title block font-semibold text-slate-950">{note.title}</span>
                    <span class="mt-1 block text-sm leading-6 text-slate-600">{note.desc}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Invitation — restrained bordered block on paper, accent left rule */}
  <section class="mx-auto max-w-7xl px-4 pb-24">
    <div
      class="border-l-draggon-violet relative overflow-hidden rounded-2xl border border-l-4 border-slate-200 bg-white p-8 md:p-10"
    >
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2">
            <span class="bg-draggon-green signal-glow h-2 w-2 rounded-full" aria-hidden="true"
            ></span>
            <span class="text-xs font-semibold tracking-[0.16em] text-slate-500 uppercase">
              Join / Collaborate
            </span>
          </div>
          <h2 class="mt-3 text-2xl tracking-tight text-slate-950">
            Build open AI-aided biodesign platforms with us
          </h2>
          <p class="mt-3 text-slate-600">
            We welcome prospective students, postdocs, collaborators, funders, open-source
            contributors, and technically curious partners interested in programmable biological
            systems.
          </p>
        </div>
        <div class="flex flex-shrink-0 flex-wrap gap-3">
          <ButtonLink href="/join-collaborate">Join / Collaborate</ButtonLink>
          <ButtonLink href="mailto:contact@draggonlab.org" variant="secondary">Contact</ButtonLink>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-capabilities]').forEach((section) => {
    const controls = Array.from(
      section.querySelectorAll<HTMLButtonElement>('[data-capability-select]'),
    );
    const cards = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-capability-card]'));

    const selectCapability = (selectedId: string) => {
      const selectedIndex = cards.findIndex((card) => card.dataset.capabilitySelect === selectedId);

      if (selectedIndex < 0) return;

      controls.forEach((control) => {
        control.setAttribute(
          'aria-pressed',
          control.dataset.capabilitySelect === selectedId ? 'true' : 'false',
        );
      });

      cards.forEach((card, index) => {
        const distanceFromFront = (index - selectedIndex + cards.length) % cards.length;
        card.dataset.position = distanceFromFront === 0 ? 'active' : `back-${distanceFromFront}`;
      });
    };

    controls.forEach((control) => {
      control.addEventListener('click', () => {
        const selectedId = control.dataset.capabilitySelect;
        if (selectedId) selectCapability(selectedId);
      });
    });
  });

  const heroAccent = document.querySelector<HTMLElement>('[data-hero-accent]');
  let heroWaveRestarting = false;

  heroAccent?.addEventListener('mouseenter', () => {
    const heroWaveIsActive = heroAccent.getAnimations().some((animation) => {
      return animation.playState === 'running';
    });

    if (heroWaveRestarting || heroWaveIsActive) return;

    heroWaveRestarting = true;
    heroAccent.style.setProperty('--hero-wave-delay', '0ms');
    heroAccent.classList.remove('hero-accent--animate');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        heroAccent.classList.add('hero-accent--animate');
        heroWaveRestarting = false;
      });
    });
  });
</script>
