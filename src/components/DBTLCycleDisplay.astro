---
const stages = [
  {
    letter: 'D',
    name: 'Design',
    summary: 'Model biological functions and compose genetic network designs.',
    tools: ['LOICA'],
    startAngle: 225,
    endAngle: 315,
  },
  {
    letter: 'B',
    name: 'Build',
    summary: 'Translate designs into reproducible assembly and automation plans.',
    tools: ['PUDU', 'BuildCompiler'],
    startAngle: 315,
    endAngle: 405,
  },
  {
    letter: 'T',
    name: 'Test',
    summary: 'Capture measurements, metadata, and characterization workflows.',
    tools: ['Flapjack', 'Tricahue'],
    startAngle: 45,
    endAngle: 135,
  },
  {
    letter: 'L',
    name: 'Learn',
    summary: 'Turn standardized results into datasets, models, and next designs.',
    tools: ['SeqTrainer', 'AI/ML'],
    startAngle: 135,
    endAngle: 225,
  },
];

const infrastructure = {
  letter: 'I',
  name: 'Infrastructure',
  summary: 'Standards, repositories, metadata, automation, and FAIR data across every stage.',
  tools: ['SynBioSuite', 'SynBioHub', 'SBOL'],
};

const cycleCenter = 250;
const outerRadius = 210;
const innerRadius = 92;
const labelRadius = 151;
const degreesToRadians = (degrees: number) => (degrees * Math.PI) / 180;
const pointOnCycle = (radius: number, angle: number) => {
  const radians = degreesToRadians(angle);
  return {
    x: cycleCenter + radius * Math.cos(radians),
    y: cycleCenter + radius * Math.sin(radians),
  };
};
const point = ({ x, y }: { x: number; y: number }) => `${x.toFixed(2)} ${y.toFixed(2)}`;
const createSectorPath = (startAngle: number, endAngle: number) =>
  [
    `M ${point(pointOnCycle(outerRadius, startAngle))}`,
    `A ${outerRadius} ${outerRadius} 0 0 1 ${point(pointOnCycle(outerRadius, endAngle))}`,
    `L ${point(pointOnCycle(innerRadius, endAngle))}`,
    `A ${innerRadius} ${innerRadius} 0 0 0 ${point(pointOnCycle(innerRadius, startAngle))}`,
    'Z',
  ].join(' ');
const createAnnulusPath = () => {
  const outerStart = pointOnCycle(outerRadius, 0);
  const outerOpposite = pointOnCycle(outerRadius, 180);
  const innerStart = pointOnCycle(innerRadius, 0);
  const innerOpposite = pointOnCycle(innerRadius, 180);

  return [
    `M ${point(outerStart)}`,
    `A ${outerRadius} ${outerRadius} 0 1 1 ${point(outerOpposite)}`,
    `A ${outerRadius} ${outerRadius} 0 1 1 ${point(outerStart)}`,
    'Z',
    `M ${point(innerStart)}`,
    `A ${innerRadius} ${innerRadius} 0 1 0 ${point(innerOpposite)}`,
    `A ${innerRadius} ${innerRadius} 0 1 0 ${point(innerStart)}`,
    'Z',
  ].join(' ');
};

const positionedStages = stages.map((stage) => {
  const middleAngle = (stage.startAngle + stage.endAngle) / 2;
  return {
    ...stage,
    id: stage.name.toLowerCase(),
    path: createSectorPath(stage.startAngle, stage.endAngle),
    label: pointOnCycle(labelRadius, middleAngle),
  };
});

const panels = [...stages, infrastructure];
const annulusPath = createAnnulusPath();
---

<section
  class="dbtl-cycle rounded-3xl border border-violet-200/70 bg-transparent p-5 shadow-sm md:p-6"
  aria-labelledby="dbtl-cycle-title"
  data-dbtl-cycle
  data-active=""
>
  <div class="dbtl-card-backdrop" aria-hidden="true">
    <img
      class="dbtl-photo"
      src="/images/photo-51.webp"
      alt=""
      width="900"
      height="900"
      loading="lazy"
      decoding="async"
    />
    <div class="dbtl-photo-treatment"></div>
  </div>

  <p id="dbtl-cycle-title" class="dbtl-cycle__title text-sm font-semibold tracking-wide uppercase">
    DBTL Cycle
  </p>
  <p class="sr-only">
    Select a workflow stage or the infrastructure core to reveal more information.
  </p>

  <div class="dbtl-interactive mt-5">
    <figure class="dbtl-figure">
      <div class="dbtl-diagram">
        <div class="dbtl-glass-surface" aria-hidden="true"></div>

        <svg class="dbtl-ring" viewBox="0 0 500 500" role="group" aria-label="DBTL cycle stages">
          <defs>
            <linearGradient id="dbtl-glass-fill" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--dbtl-glass-edge)" stop-opacity="0.12"></stop>
              <stop offset="0.46" stop-color="var(--dbtl-glass-edge)" stop-opacity="0.025"></stop>
              <stop offset="1" stop-color="var(--dbtl-glass-tint)" stop-opacity="0.07"></stop>
            </linearGradient>
            <linearGradient id="dbtl-glass-rim" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="var(--dbtl-glass-edge)" stop-opacity="0.72"></stop>
              <stop offset="0.26" stop-color="var(--dbtl-glass-tint)" stop-opacity="0.16"></stop>
              <stop offset="0.58" stop-color="var(--dbtl-glass-edge)" stop-opacity="0.42"></stop>
              <stop offset="1" stop-color="var(--dbtl-glass-tint)" stop-opacity="0.28"></stop>
            </linearGradient>
            {
              positionedStages.map((stage) => (
                <>
                  <radialGradient
                    id={`dbtl-${stage.id}-hover`}
                    gradientUnits="userSpaceOnUse"
                    cx={stage.label.x}
                    cy={stage.label.y}
                    r="82"
                  >
                    <stop offset="0" stop-color="var(--dbtl-glow)" stop-opacity="0.28" />
                    <stop offset="0.42" stop-color="var(--dbtl-glow)" stop-opacity="0.1" />
                    <stop offset="1" stop-color="var(--dbtl-glow)" stop-opacity="0" />
                  </radialGradient>
                  <radialGradient
                    id={`dbtl-${stage.id}-active`}
                    gradientUnits="userSpaceOnUse"
                    cx={stage.label.x}
                    cy={stage.label.y}
                    r="148"
                  >
                    <stop offset="0" stop-color="var(--dbtl-glow)" stop-opacity="0.42" />
                    <stop offset="0.46" stop-color="var(--dbtl-glow)" stop-opacity="0.2" />
                    <stop offset="1" stop-color="var(--dbtl-glow)" stop-opacity="0" />
                  </radialGradient>
                </>
              ))
            }
          </defs>

          <path
            class="dbtl-ring__glass"
            d={annulusPath}
            fill="url(#dbtl-glass-fill)"
            fill-rule="evenodd"
            stroke="url(#dbtl-glass-rim)"></path>

          {
            positionedStages.map((stage) => (
              <g
                class="dbtl-segment"
                data-dbtl-control={stage.id}
                role="button"
                tabindex="0"
                aria-label={`Show ${stage.name} details`}
                aria-controls={`dbtl-panel-${stage.id}`}
                aria-expanded="false"
              >
                <path
                  class="dbtl-segment__light dbtl-segment__light--hover"
                  d={stage.path}
                  fill={`url(#dbtl-${stage.id}-hover)`}
                />
                <path
                  class="dbtl-segment__light dbtl-segment__light--active"
                  d={stage.path}
                  fill={`url(#dbtl-${stage.id}-active)`}
                />
                <path class="dbtl-segment__hit-area" d={stage.path} />
                <text x={stage.label.x} y={stage.label.y} dy="0.35em">
                  {stage.name}
                </text>
              </g>
            ))
          }
        </svg>

        <button
          type="button"
          class="dbtl-core-trigger"
          data-dbtl-control="infrastructure"
          aria-controls="dbtl-panel-infrastructure"
          aria-expanded="false"
        >
          <span>Infrastructure</span>
        </button>
      </div>

      <figcaption class="dbtl-credit">
        Photo 51, X-ray diffraction of DNA (1952), produced by Raymond Gosling under Rosalind
        Franklin’s supervision.
        <a href="https://www.worldhistory.org/image/21344/photograph-51/">Image source</a>.
      </figcaption>
    </figure>

    <div class="dbtl-detail-layer" aria-live="polite" aria-atomic="true">
      {
        panels.map((panel) => {
          const id = panel.name.toLowerCase();
          return (
            <article id={`dbtl-panel-${id}`} class="dbtl-detail" data-dbtl-panel={id} hidden>
              <div class="dbtl-detail__title">
                <span class="dbtl-detail__badge" aria-hidden="true">
                  {panel.letter}
                </span>
                <h4>{panel.name}</h4>
              </div>
              <p class="dbtl-detail__summary">{panel.summary}</p>
              <div class="dbtl-tools">
                <p>Selected tools</p>
                <ul aria-label={`${panel.name} tools`}>
                  {panel.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-dbtl-cycle]').forEach((cycle) => {
    const controls = Array.from(cycle.querySelectorAll<HTMLElement>('[data-dbtl-control]'));
    const panels = Array.from(cycle.querySelectorAll<HTMLElement>('[data-dbtl-panel]'));
    let active = '';

    const setActive = (requested: string) => {
      active = requested === active ? '' : requested;
      cycle.dataset.active = active;

      controls.forEach((control) => {
        control.setAttribute('aria-expanded', String(control.dataset.dbtlControl === active));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.dbtlPanel !== active;
      });
    };

    controls.forEach((control) => {
      control.addEventListener('click', () => setActive(control.dataset.dbtlControl ?? ''));

      if (control.getAttribute('role') === 'button') {
        control.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            setActive(control.dataset.dbtlControl ?? '');
          }
        });
      }
    });

    cycle.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && active) {
        const previous = active;
        setActive(previous);
        controls.find((control) => control.dataset.dbtlControl === previous)?.focus();
      }
    });
  });
</script>
