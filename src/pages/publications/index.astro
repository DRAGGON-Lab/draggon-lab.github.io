---
import BaseLayout from '../../layouts/BaseLayout.astro';
import publicationData from '../../data/publications.generated.json';
import { sortPublications, type PublicationSnapshot } from '../../lib/publications';

const snapshot = publicationData as PublicationSnapshot;
const publications = sortPublications(snapshot.publications, 'newest');
const synchronizedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(snapshot.generatedAt));
const serializedSnapshot = JSON.stringify(snapshot).replaceAll('<', '\\u003c');
const headlineMetrics = [
  { label: 'Works', value: snapshot.publications.length },
  { label: 'Citations', value: snapshot.profile.totalCitations },
  { label: 'h-index', value: snapshot.profile.hIndex },
  { label: 'i10-index', value: snapshot.profile.i10Index },
];
---

<BaseLayout
  title="Publications"
  description="Search Gonzalo Vidal's publications and explore citation relationships between them."
>
  <section class="publication-page mx-auto max-w-7xl px-4 py-16">
    <div class="publication-summary">
      <header>
        <h1 class="text-4xl font-bold tracking-tight text-slate-950">Publications</h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
          Search the complete public profile, compare citation counts, or follow how these works
          cite one another over time.
        </p>
        <a
          class="profile-link mt-3 inline-block text-sm"
          href={snapshot.profile.url}
          target="_blank"
          rel="noreferrer">View source on Google Scholar <span aria-hidden="true">↗</span></a
        >
      </header>

      <div class="metrics-widget">
        <div class="metrics-interactive">
          <dl class="metrics" aria-label="Google Scholar profile summary">
            {
              headlineMetrics.map((metric) => (
                <div class="metric-card">
                  <dt>{metric.label}</dt>
                  <dd
                    class="flip-number"
                    data-metric-value={metric.value}
                    aria-label={String(metric.value)}
                  >
                    {String(metric.value)
                      .split('')
                      .map((digit) => (
                        <span
                          class="flip-digit"
                          data-flip-digit
                          data-target-digit={digit}
                          data-current-digit={digit}
                          aria-hidden="true"
                        >
                          <span class="flip-half flip-static-top">
                            <span class="flip-glyph">{digit}</span>
                          </span>
                          <span class="flip-half flip-static-bottom">
                            <span class="flip-glyph">{digit}</span>
                          </span>
                          <span class="flip-leaf">
                            <span class="flip-face flip-front">
                              <span class="flip-glyph">{digit}</span>
                            </span>
                            <span class="flip-face flip-back">
                              <span class="flip-glyph">{digit}</span>
                            </span>
                          </span>
                        </span>
                      ))}
                  </dd>
                </div>
              ))
            }
          </dl>
          <button class="metrics-replay" type="button" aria-label="Replay metric animation">
            <span class="sr-only">Replay metric animation</span>
          </button>
        </div>
        <div class="metric-update-status" data-metric-update hidden aria-live="polite">
          <span class="update-pulse" aria-hidden="true"></span>
          <span>Last updated</span>
          <time datetime={snapshot.generatedAt}>{synchronizedDate}</time>
        </div>
      </div>
    </div>

    <section class="explorer" aria-labelledby="explorer-heading">
      <div class="explorer-heading-row">
        <h2 id="explorer-heading">Publication explorer</h2>
        <div class="view-switch" aria-label="Publication view">
          <button type="button" data-view-button="table" aria-pressed="true">Table</button>
          <button type="button" data-view-button="graph" aria-pressed="false">Graph</button>
        </div>
      </div>

      <div class="explorer-controls">
        <label class="search-field"
          ><span>Search publications</span><input
            id="publication-search"
            type="search"
            placeholder="Title, author, venue, year, or type"
            autocomplete="off"
          /></label
        >
        <label class="sort-field" data-table-control
          ><span>Sort by</span><select id="publication-sort"
            ><option value="newest">Newest first</option><option value="oldest">Oldest first</option
            ><option value="cited">Most cited</option><option value="title">Title</option></select
          ></label
        >
        <div class="direction-control" data-graph-control hidden>
          <span>Timeline direction</span><div class="direction-buttons">
            <button type="button" data-direction="oldest" aria-pressed="true"
              >Oldest → newest</button
            ><button type="button" data-direction="newest" aria-pressed="false"
              >Newest → oldest</button
            >
          </div>
        </div>
      </div>
      <p class="result-status" id="publication-status" aria-live="polite">
        Showing {publications.length} publications
      </p>

      <div id="table-view">
        <div class="publication-table-wrap">
          <table class="publication-table">
            <colgroup>
              <col class="year-column" />
              <col class="publication-column" />
              <col class="venue-column" />
              <col class="type-column" />
              <col class="citation-column" />
              <col class="links-column" />
            </colgroup>
            <thead
              ><tr
                ><th>Year</th><th>Publication</th><th>Venue</th><th>Type</th><th>Citations</th><th
                  >Links</th
                ></tr
              ></thead
            >
            <tbody id="publication-rows">
              {
                publications.map((publication) => (
                  <tr data-publication-id={publication.id}>
                    <td data-label="Year">{publication.year ?? '—'}</td>
                    <td data-label="Publication">
                      <>
                        <strong title={publication.title}>
                          <a href={publication.scholarUrl} target="_blank" rel="noreferrer">
                            {publication.title}
                          </a>
                        </strong>
                        <span class="publication-authors" title={publication.authors.join(', ')}>
                          {publication.authors.join(', ')}
                        </span>
                      </>
                    </td>
                    <td data-label="Venue">{publication.venue || 'Venue not listed'}</td>
                    <td data-label="Type">
                      <span class="type-label">{publication.type}</span>
                    </td>
                    <td data-label="Scholar citations" class="citation-cell">
                      <button
                        type="button"
                        class="citation-copy"
                        data-copy-bibtex={publication.id}
                        aria-label={`Copy BibTeX for ${publication.title}`}
                        title="Copy BibTeX"
                      >
                        {publication.scholarCitations}
                        <span aria-hidden="true">⧉</span>
                      </button>
                    </td>
                    <td data-label="Links" class="publication-links">
                      {publication.doi && (
                        <a
                          href={`https://doi.org/${publication.doi}`}
                          target="_blank"
                          rel="noreferrer"
                        >
                          DOI
                        </a>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="empty-state" id="table-empty" hidden>No publications match this search.</p>
      </div>

      <div id="graph-view" hidden>
        <div class="graph-intro">
          <p>
            Arrows run from a citing work to a cited work. Connections are limited to publications
            on this profile and depend on OpenAlex reference coverage.
          </p>
          <div class="size-legend" aria-label="Node size represents Google Scholar citations">
            <span class="legend-dot legend-dot-small"></span><span>Fewer citations</span><span
              class="legend-dot legend-dot-large"></span><span>More citations</span>
          </div>
        </div>
        <div class="timeline-shell">
          <svg
            id="citation-graph"
            viewBox="0 0 1100 300"
            role="img"
            aria-labelledby="graph-title graph-description"
            ><title id="graph-title">Chronological citation graph</title><desc
              id="graph-description"
              >Publications are ordered by year. Node size represents Google Scholar citations and
              arrows represent references between displayed publications.</desc
            ></svg
          >
        </div>
        <aside class="graph-detail" id="graph-detail" aria-live="polite">
          <p class="detail-placeholder">Select or focus a publication to inspect it.</p>
        </aside>
      </div>
    </section>
    <script is:inline type="application/json" id="publication-data" set:html={serializedSnapshot} />
  </section>
</BaseLayout>

<script>
  import {
    filterPublications,
    placePublicationsChronologically,
    publicationToBibtex,
    sortPublications,
    type Publication,
    type PublicationSnapshot,
    type PublicationSort,
  } from '../../lib/publications';

  const dataElement = document.querySelector<HTMLScriptElement>('#publication-data');
  const snapshot = JSON.parse(dataElement?.textContent ?? '{}') as PublicationSnapshot;
  const search = document.querySelector<HTMLInputElement>('#publication-search');
  const sort = document.querySelector<HTMLSelectElement>('#publication-sort');
  const tableView = document.querySelector<HTMLElement>('#table-view');
  const graphView = document.querySelector<HTMLElement>('#graph-view');
  const tableBody = document.querySelector<HTMLTableSectionElement>('#publication-rows');
  const tableRows = new Map(
    [...(tableBody?.querySelectorAll<HTMLTableRowElement>('[data-publication-id]') ?? [])].map(
      (row) => [row.dataset.publicationId ?? '', row],
    ),
  );
  const publicationById = new Map(
    snapshot.publications.map((publication) => [publication.id, publication]),
  );
  const citationButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-copy-bibtex]')];
  const tableEmpty = document.querySelector<HTMLElement>('#table-empty');
  const status = document.querySelector<HTMLElement>('#publication-status');
  const graph = document.querySelector<SVGSVGElement>('#citation-graph');
  const graphDetail = document.querySelector<HTMLElement>('#graph-detail');
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-view-button]')];
  const directionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-direction]')];
  const graphControls = document.querySelector<HTMLElement>('[data-graph-control]');
  const tableControl = document.querySelector<HTMLElement>('[data-table-control]');
  const metricReplay = document.querySelector<HTMLButtonElement>('.metrics-replay');
  const metricDigits = [...document.querySelectorAll<HTMLElement>('[data-flip-digit]')];
  const metricUpdate = document.querySelector<HTMLElement>('[data-metric-update]');
  let currentView: 'table' | 'graph' = 'table';
  let newestFirst = false;
  let selectedId: string | null = null;
  let metricAnimationRun = 0;
  const svgNamespace = 'http://www.w3.org/2000/svg';

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[character] ??
        character,
    );
  function publicationLinks(publication: Publication): string {
    return publication.doi
      ? `<a href="https://doi.org/${encodeURIComponent(publication.doi)}" target="_blank" rel="noreferrer">DOI</a>`
      : '';
  }
  function renderTable(items: Publication[]) {
    if (!tableBody) return;
    for (const row of tableRows.values()) row.hidden = true;
    for (const publication of items) {
      const row = tableRows.get(publication.id);
      if (!row) continue;
      row.hidden = false;
      tableBody.append(row);
    }
    if (tableEmpty) tableEmpty.hidden = items.length > 0;
  }
  function setFlipGlyph(digit: HTMLElement, selector: string, value: number) {
    const glyph = digit.querySelector<HTMLElement>(selector);
    if (glyph) glyph.textContent = String(value);
  }
  function settleFlipDigit(digit: HTMLElement, value: number) {
    digit.classList.remove('is-flipping');
    setFlipGlyph(digit, '.flip-static-top .flip-glyph', value);
    setFlipGlyph(digit, '.flip-static-bottom .flip-glyph', value);
    setFlipGlyph(digit, '.flip-front .flip-glyph', value);
    setFlipGlyph(digit, '.flip-back .flip-glyph', value);
    digit.dataset.currentDigit = String(value);
  }
  const wait = (duration: number) =>
    new Promise<void>((resolve) => window.setTimeout(resolve, duration));

  async function playMetricAnimation() {
    const run = ++metricAnimationRun;
    const reduceMotion =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.classList.contains('animations-off');
    if (reduceMotion) {
      metricDigits.forEach((digit) =>
        settleFlipDigit(digit, Number(digit.dataset.targetDigit ?? 0)),
      );
      if (metricUpdate) metricUpdate.hidden = true;
      return;
    }

    metricDigits.forEach((digit) => settleFlipDigit(digit, 0));
    if (metricUpdate) {
      metricUpdate.hidden = false;
      metricUpdate.classList.remove('is-visible');
      void metricUpdate.offsetWidth;
      metricUpdate.classList.add('is-visible');
    }
    await wait(180);

    const highestTarget = Math.max(
      0,
      ...metricDigits.map((digit) => Number(digit.dataset.targetDigit ?? 0)),
    );
    for (let nextValue = 1; nextValue <= highestTarget; nextValue += 1) {
      if (run !== metricAnimationRun) return;
      const activeDigits = metricDigits.filter(
        (digit) => Number(digit.dataset.targetDigit ?? 0) >= nextValue,
      );
      activeDigits.forEach((digit) => {
        const currentValue = nextValue - 1;
        setFlipGlyph(digit, '.flip-static-top .flip-glyph', nextValue);
        setFlipGlyph(digit, '.flip-static-bottom .flip-glyph', currentValue);
        setFlipGlyph(digit, '.flip-front .flip-glyph', currentValue);
        setFlipGlyph(digit, '.flip-back .flip-glyph', nextValue);
        digit.classList.remove('is-flipping');
        void digit.offsetWidth;
      });
      activeDigits.forEach((digit) => digit.classList.add('is-flipping'));
      await wait(420);
      if (run !== metricAnimationRun) return;
      activeDigits.forEach((digit) => settleFlipDigit(digit, nextValue));
    }

    await wait(160);
    if (run !== metricAnimationRun) return;
    if (metricUpdate) metricUpdate.classList.remove('is-visible');
    await wait(300);
    if (run === metricAnimationRun && metricUpdate) metricUpdate.hidden = true;
  }
  async function writeToClipboard(value: string): Promise<void> {
    await navigator.clipboard.writeText(value);
  }
  citationButtons.forEach((button) =>
    button.addEventListener('click', async () => {
      const publication = publicationById.get(button.dataset.copyBibtex ?? '');
      if (!publication) return;
      try {
        await writeToClipboard(publicationToBibtex(publication));
        button.classList.add('is-copied');
        button.title = 'BibTeX copied';
        if (status) status.textContent = `BibTeX copied for “${publication.title}”`;
        window.setTimeout(() => {
          button.classList.remove('is-copied');
          button.title = 'Copy BibTeX';
          if (status && currentView === 'table') {
            const count = visibleItems().length;
            status.textContent = `Showing ${count} of ${snapshot.publications.length} publications`;
          }
        }, 1800);
      } catch {
        if (status) status.textContent = 'Could not copy BibTeX. Please try again.';
      }
    }),
  );
  function svgElement<K extends keyof SVGElementTagNameMap>(
    name: K,
    attributes: Record<string, string>,
  ) {
    const element = document.createElementNS(svgNamespace, name);
    for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, value);
    return element;
  }
  function selectNode(id: string, items: Publication[]) {
    selectedId = id;
    const connected = new Set([id]);
    for (const edge of snapshot.citationEdges) {
      if (edge.source === id) connected.add(edge.target);
      if (edge.target === id) connected.add(edge.source);
    }
    graph?.querySelectorAll<SVGElement>('[data-node-id]').forEach((node) => {
      node.classList.toggle('is-dimmed', !connected.has(node.dataset.nodeId ?? ''));
      node.classList.toggle('is-selected', node.dataset.nodeId === id);
    });
    graph?.querySelectorAll<SVGElement>('[data-edge-source]').forEach((edge) => {
      const active = edge.dataset.edgeSource === id || edge.dataset.edgeTarget === id;
      edge.classList.toggle('is-dimmed', !active);
      edge.classList.toggle('is-highlighted', active);
    });
    const publication = items.find((item) => item.id === id);
    if (!publication || !graphDetail) return;
    const date = publication.publicationDate
      ? new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          timeZone: 'UTC',
        }).format(new Date(publication.publicationDate))
      : (publication.year?.toString() ?? 'Date not listed');
    graphDetail.innerHTML = `<p class="detail-eyebrow">${publication.type} · ${date}</p><h3><a href="${escapeHtml(publication.scholarUrl)}" target="_blank" rel="noreferrer">${escapeHtml(publication.title)}</a></h3><p>${escapeHtml(publication.authors.join(', '))}</p><p>${escapeHtml(publication.venue || 'Venue not listed')} · <strong>${publication.scholarCitations}</strong> Scholar citations</p><div class="publication-links">${publicationLinks(publication)}</div>`;
  }
  function renderGraph(items: Publication[]) {
    if (!graph) return;
    graph.querySelectorAll(':scope > :not(title):not(desc)').forEach((element) => element.remove());
    const marker = svgElement('marker', {
      id: 'arrowhead',
      markerWidth: '7',
      markerHeight: '7',
      refX: '6',
      refY: '3.5',
      orient: 'auto',
    });
    marker.append(svgElement('path', { d: 'M0,0 L7,3.5 L0,7 z', class: 'arrowhead' }));
    const definitions = svgElement('defs', {});
    definitions.append(marker);
    graph.append(definitions);
    if (!items.length) {
      if (graphDetail)
        graphDetail.innerHTML =
          '<p class="detail-placeholder">No publications match this search.</p>';
      return;
    }
    const points = placePublicationsChronologically(items, 1100, newestFirst);
    const pointById = new Map(points.map((point) => [point.id, point]));
    graph.append(
      svgElement('line', { x1: '38', y1: '260', x2: '1062', y2: '260', class: 'timeline-axis' }),
    );
    for (const edge of snapshot.citationEdges) {
      const source = pointById.get(edge.source);
      const target = pointById.get(edge.target);
      if (!source || !target) continue;
      const midpoint = (source.x + target.x) / 2;
      graph.append(
        svgElement('path', {
          d: `M ${source.x} ${source.y} Q ${midpoint} ${Math.max(18, Math.min(source.y, target.y) - 38)} ${target.x} ${target.y}`,
          class: 'citation-edge',
          'data-edge-source': edge.source,
          'data-edge-target': edge.target,
          'marker-end': 'url(#arrowhead)',
        }),
      );
    }
    for (const publication of items) {
      const point = pointById.get(publication.id);
      if (!point) continue;
      const group = svgElement('g', {
        class: 'publication-node',
        role: 'button',
        tabindex: '0',
        'data-node-id': publication.id,
        'aria-label': `${publication.title}, ${publication.year ?? 'year unknown'}, ${publication.scholarCitations} citations`,
      });
      group.append(
        svgElement('circle', { cx: String(point.x), cy: String(point.y), r: String(point.radius) }),
      );
      const year = svgElement('text', {
        x: String(point.x),
        y: '282',
        'text-anchor': 'middle',
        class: 'node-year',
      });
      year.textContent = publication.year?.toString() ?? 'n.d.';
      const title = svgElement('title', {});
      title.textContent = `${publication.title} — ${publication.scholarCitations} citations`;
      group.append(year, title);
      group.addEventListener('click', () => selectNode(publication.id, items));
      group.addEventListener('focus', () => selectNode(publication.id, items));
      group.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectNode(publication.id, items);
        }
      });
      graph.append(group);
    }
    const active = items.some((item) => item.id === selectedId) ? selectedId : items[0].id;
    selectNode(active ?? items[0].id, items);
  }
  function visibleItems() {
    return sortPublications(
      filterPublications(snapshot.publications, search?.value ?? ''),
      (sort?.value ?? 'newest') as PublicationSort,
    );
  }
  function render() {
    const items = visibleItems();
    if (status)
      status.textContent = `Showing ${items.length} of ${snapshot.publications.length} publications`;
    currentView === 'table' ? renderTable(items) : renderGraph(items);
  }
  function setView(view: 'table' | 'graph', updateUrl = true) {
    currentView = view;
    if (tableView) tableView.hidden = view !== 'table';
    if (graphView) graphView.hidden = view !== 'graph';
    if (graphControls) graphControls.hidden = view !== 'graph';
    if (tableControl) tableControl.hidden = view !== 'table';
    for (const button of viewButtons)
      button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('view', view);
      window.history.replaceState({}, '', url);
    }
    render();
  }
  viewButtons.forEach((button) =>
    button.addEventListener('click', () =>
      setView(button.dataset.viewButton === 'graph' ? 'graph' : 'table'),
    ),
  );
  directionButtons.forEach((button) =>
    button.addEventListener('click', () => {
      newestFirst = button.dataset.direction === 'newest';
      directionButtons.forEach((item) =>
        item.setAttribute('aria-pressed', String(item === button)),
      );
      render();
    }),
  );
  search?.addEventListener('input', render);
  sort?.addEventListener('change', render);
  metricReplay?.addEventListener('click', () => void playMetricAnimation());
  void playMetricAnimation();
  setView(
    new URL(window.location.href).searchParams.get('view') === 'graph' ? 'graph' : 'table',
    false,
  );
</script>

<style>
  .publication-page {
    color: var(--color-text);
  }
  .profile-link,
  .publication-links a {
    color: var(--color-accent-strong);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    text-underline-offset: 0.2em;
  }
  .publication-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(24rem, 31rem);
    gap: 3rem;
    align-items: center;
  }
  .metrics-widget {
    position: relative;
    isolation: isolate;
    width: 100%;
  }
  .metrics-interactive {
    position: relative;
    z-index: 2;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-surface-muted);
    box-shadow: var(--shadow-card);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }
  .metrics div {
    padding: 0.3rem 0.65rem;
    text-align: center;
  }
  .metrics-replay {
    position: absolute;
    z-index: 2;
    inset: 0;
    border: 0;
    border-radius: 0.85rem;
    background: transparent;
    cursor: pointer;
  }
  .metrics-interactive:hover .metrics {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-lift);
  }
  .metrics dt {
    color: var(--color-muted);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .metrics dd {
    margin: 0.18rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.3rem;
    line-height: 1;
  }
  .metrics .flip-number {
    display: flex;
    justify-content: center;
    gap: 0.12rem;
    margin-top: 0.3rem;
  }
  .flip-digit {
    --flip-height: 1.62rem;
    position: relative;
    display: inline-block;
    width: 1.18rem;
    height: var(--flip-height);
    border-radius: 0.2rem;
    box-shadow:
      0 2px 4px rgba(23, 21, 38, 0.22),
      inset 0 1px rgba(255, 255, 255, 0.13);
    color: white;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    font-weight: 750;
    line-height: 1;
    perspective: 8rem;
  }
  .flip-half,
  .flip-face {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: hidden;
