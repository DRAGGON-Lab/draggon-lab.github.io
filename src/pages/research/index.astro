---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchAscent from '../../components/ResearchAscent.astro';
import { includeEntryInEnvironment } from '../../lib/contentFilters';
import { getResearchHierarchy, sortResearchByHierarchy } from '../../data/researchHierarchy';

const entries = sortResearchByHierarchy(
  (await getCollection('research')).filter(includeEntryInEnvironment),
);
---

<BaseLayout title="Research" description="Explore the DRAGGON Lab research vision.">
  <section class="brand-page-intro mx-auto max-w-7xl px-4 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-slate-950">Research</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
      DRAGGON Lab builds AI-aided biodesign platforms across biological software foundations, DBTL
      workflows, machine learning, digital twins, and intelligent genetic networks.
    </p>
    <div class="mt-10">
      <ResearchAscent
        items={entries.map((entry) => ({
          order: getResearchHierarchy(entry.id).order,
          title: entry.data.title,
          summary: entry.data.summary,
          href: `/research/${entry.id}/`,
        }))}
      />
    </div>
  </section>
</BaseLayout>
