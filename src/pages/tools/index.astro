---
import GitHubRepositoryCard from '../../components/cards/GitHubRepositoryCard.astro';
import DBTLCycleDisplay from '../../components/DBTLCycleDisplay.astro';
import repositorySnapshot from '../../data/githubRepositories.generated.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GitHubRepository } from '../../lib/githubRepositories';

const repositories = repositorySnapshot.repositories as GitHubRepository[];
---

<BaseLayout
  title="Platform Ecosystem"
  description="Tools for designing, building, testing, learning from, and sharing programmable biological systems."
>
  <section class="brand-page-intro mx-auto max-w-7xl px-4 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-slate-950">Platform Ecosystem</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
      Our tools form a modular platform ecosystem for designing, building, testing, learning from,
      and sharing programmable biological systems. This catalog is synchronized from the public
      DRAGGON Lab GitHub organization whenever the website is deployed, with the last successful
      snapshot retained if GitHub is temporarily unavailable.
    </p>
    <div class="mt-8">
      <DBTLCycleDisplay />
    </div>

    <div class="mt-8 max-w-xl">
      <label for="repository-search" class="block text-sm font-semibold text-slate-950"
        >Search repositories</label
      >
      <div class="mt-2">
        <input
          id="repository-search"
          type="search"
          placeholder="Search by repository, description, stage, or language"
          class="focus:border-draggon-violet focus:ring-draggon-violet/20 w-full rounded-full border border-slate-300 bg-white px-5 py-3 text-sm text-slate-950 shadow-sm transition outline-none placeholder:text-slate-400 focus:ring-4"
          aria-describedby="repository-search-help repository-search-count"
        />
      </div>
      <p id="repository-search-help" class="mt-2 text-sm text-slate-600">
        Search across repository names, descriptions, development stages, and languages.
      </p>
      <p id="repository-search-count" class="sr-only" aria-live="polite"></p>
    </div>

    <div id="repositories-grid" class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        repositories.map((repository) => {
          const searchText = [
            repository.name,
            repository.description,
            repository.classification,
            ...repository.ecosystemTags,
            ...repository.languages.map((language) => language.name),
          ]
            .filter(Boolean)
            .join(' ');

          return (
            <div
              class="repository-card"
              data-repository-search={searchText}
              data-repository-filters={[
                repository.classification,
                ...repository.ecosystemTags,
              ].join('|')}
            >
              <GitHubRepositoryCard repository={repository} />
            </div>
          );
        })
      }
    </div>
    <p
      id="repositories-empty"
      class="mt-8 hidden rounded-2xl border border-dashed border-slate-300 p-6 text-sm text-slate-600"
    >
      No repositories match your search. Clear the search field to show all repository cards again.
    </p>
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#repository-search');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.repository-card'));
    const emptyState = document.querySelector<HTMLElement>('#repositories-empty');
    const count = document.querySelector<HTMLElement>('#repository-search-count');
    const filterButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-repository-filter]'),
    );
    let activePillFilter = '';

    const updateRepositorySearch = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      let visibleCards = 0;

      cards.forEach((card) => {
        const text = card.dataset.repositorySearch?.toLowerCase() ?? '';
        const filters = (card.dataset.repositoryFilters ?? '').toLowerCase().split('|');
        const isVisible =
          query === '' ||
          (activePillFilter ? filters.includes(activePillFilter) : text.includes(query));
        card.hidden = !isVisible;
        if (isVisible) visibleCards += 1;
      });

      filterButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.repositoryFilter?.toLowerCase() === activePillFilter),
        );
      });

      emptyState?.classList.toggle('hidden', visibleCards > 0);
      if (count) {
        count.textContent = `${visibleCards} ${visibleCards === 1 ? 'repository' : 'repositories'} shown`;
      }
    };

    searchInput?.addEventListener('input', () => {
      activePillFilter = '';
      updateRepositorySearch();
    });
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const requestedFilter = button.dataset.repositoryFilter?.toLowerCase() ?? '';
        activePillFilter = activePillFilter === requestedFilter ? '' : requestedFilter;
        if (searchInput) {
          searchInput.value = activePillFilter
            ? (button.dataset.repositoryFilterLabel ?? button.dataset.repositoryFilter ?? '')
            : '';
          searchInput.focus();
        }
        updateRepositorySearch();
      });
    });
    updateRepositorySearch();
  </script>
</BaseLayout>
